# BiotecPredict — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com valores reais

# ── Banco de Dados ──────────────────────────────────────────
# Local único e oficial: backend/data/biotecpredict.db (criado automaticamente).
# Deixe DATABASE_URL sem definir para usar esse default — só sobrescreva se
# quiser apontar para outro arquivo/engine (ex: Postgres em produção).
# Em Docker, o docker-compose já define DATABASE_URL apontando para o volume
# nomeado biotecpredict_data (ver deploy/docker-compose.yml).
# DATABASE_URL=sqlite:///./data/biotecpredict.db

# Banco de teste: a suíte pytest usa SQLite in-memory (backend/tests/pytest/conftest.py),
# não um arquivo em disco — não defina DATABASE_TEST_URL, ela não é lida pelo código.

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173

# ── ML ──────────────────────────────────────────────────────
ML_MODEL_PATH=backend/ml/models/random_forest.pkl
ML_RETRAIN_ON_STARTUP=false
