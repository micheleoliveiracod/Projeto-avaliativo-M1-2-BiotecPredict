# BiotecPredict — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com valores reais

# ── Banco de Dados ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/biotecpredict
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/biotecpredict_test

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173

# ── ML ──────────────────────────────────────────────────────
ML_MODEL_PATH=backend/ml/models/random_forest.pkl
ML_RETRAIN_ON_STARTUP=false
